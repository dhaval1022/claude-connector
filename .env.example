# Copy to .env (or set as real environment variables). All settings use the CONNECTOR_ prefix.
# NEVER commit the real file. Generate secrets with:
#   python -m app.cli gen-key       -> CONNECTOR_MASTER_KEY
#   python -m app.cli gen-secret    -> CONNECTOR_JWT_SECRET

# --- required ------------------------------------------------------------------------------
# Public HTTPS URL users/Claude reach (no trailing slash). Must match what the proxy serves.
CONNECTOR_PUBLIC_BASE_URL=https://connector.example.com
# Encrypts stored database credentials (AES-256-GCM). LOSING THIS KEY MAKES ALL STORED
# CREDENTIALS UNRECOVERABLE: back it up separately from the database.
CONNECTOR_MASTER_KEY=
# Signs OAuth access tokens, web sessions and download links (32+ random chars).
CONNECTOR_JWT_SECRET=

# --- metadata database ---------------------------------------------------------------------
# Default is a local SQLite file, fine for a small team. For PostgreSQL:
#   pip install ".[metadata-postgres]"  and use postgresql+asyncpg://user:pass@host/dbname
# Keep this OUT of OneDrive/Dropbox-synced folders (use an absolute local path).
CONNECTOR_DATABASE_URL=sqlite+aiosqlite:///C:/claude-connector-data/connector.db
# Uploaded files, per-source DuckDB databases and exports live here. Back it up if you care
# about uploaded-file sources; exports are temporary.
CONNECTOR_DATA_DIR=C:/claude-connector-data/data

# --- OAuth ---------------------------------------------------------------------------------
# Redirect URIs clients may register. Loopback entries allow any port on that host (CLI clients);
# others must match host exactly. Remove the loopback entries to allow only claude.ai.
# JSON list:
#CONNECTOR_ALLOWED_REDIRECT_PREFIXES=["https://claude.ai/api/mcp/auth_callback"]
CONNECTOR_ACCESS_TOKEN_TTL_S=1800
CONNECTOR_REFRESH_TOKEN_TTL_S=2592000

# --- query limits --------------------------------------------------------------------------
CONNECTOR_DEFAULT_MAX_ROWS=500
CONNECTOR_HARD_MAX_ROWS=10000
CONNECTOR_QUERY_TIMEOUT_S=60
CONNECTOR_EXPORT_MAX_ROWS=2000000
CONNECTOR_EXPORT_MAX_MB=500
CONNECTOR_EXPORT_TIMEOUT_S=600
CONNECTOR_EXPORT_RETENTION_H=24
CONNECTOR_MAX_UPLOAD_MB=100

# --- rate limits (in-process: correct for ONE server process) -------------------------------
CONNECTOR_RATE_TOOLS_PER_MIN=240
CONNECTOR_RATE_QUERIES_PER_MIN=60
CONNECTOR_RATE_EXPORTS_PER_HOUR=20
CONNECTOR_RATE_LOGIN_PER_MIN_IP=20
CONNECTOR_RATE_TOKEN_PER_MIN_IP=60
# Number of reverse proxies in front of the app (so client IPs come from X-Forwarded-For).
# 0 = trust nothing. With the bundled Caddy/nginx setups use 1.
CONNECTOR_TRUSTED_PROXY_COUNT=1

# --- network safety ------------------------------------------------------------------------
# Link-local / cloud-metadata addresses are always blocked for user-supplied DB hosts.
CONNECTOR_ALLOW_LOOPBACK=false
# Dev/test only: lets users register a local SQLite file (arbitrary file access!). Keep false.
CONNECTOR_ENABLE_SQLITE=false
# Extra Host header values accepted besides the one in PUBLIC_BASE_URL (JSON list).
#CONNECTOR_ALLOWED_HOSTS=["connector.internal"]

# --- observability -------------------------------------------------------------------------
# /metrics (Prometheus) is disabled unless a token is set; scrape with
#   Authorization: Bearer <token>
CONNECTOR_METRICS_TOKEN=
CONNECTOR_LOG_JSON=true
CONNECTOR_AUDIT_RETENTION_DAYS=180
